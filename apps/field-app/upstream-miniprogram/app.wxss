page {
  background: #F7F5EC;
  color: #17352A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view,
text,
image,
button,
scroll-view,
input {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}

.page-title {
  color: #17352A;
  font-size: 44rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.page-kicker {
  color: #7C8A82;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.section-title {
  color: #17352A;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-desc {
  color: #7C8A82;
  font-size: 23rpx;
  line-height: 1.6;
}

.surface-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 107, 58, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(36, 78, 56, 0.07);
}

.bottom-safe-space {
  height: calc(132rpx + env(safe-area-inset-bottom));
}

/* Both tab pages share geometry so switching tabs keeps the header stationary. */
.tool-page-header {
  flex-shrink: 0;
  padding: 30px 30rpx 22rpx;
  color: #FFFFFF;
  background: linear-gradient(138deg, #155F36, #1D7A47);
  border-bottom-right-radius: 40rpx;
}

.tool-header-title-row { display: flex; align-items: center; }
.tool-header-title { display: block; flex-shrink: 0; font-size: 40rpx; font-weight: 760; line-height: 1.3; white-space: nowrap; }
.tool-header-bottom { display: flex; align-items: center; justify-content: space-between; min-height: 60rpx; margin-top: 10rpx; }
.tool-header-desc { display: block; color: rgba(255, 255, 255, 0.82); font-size: 21rpx; line-height: 1.5; }
