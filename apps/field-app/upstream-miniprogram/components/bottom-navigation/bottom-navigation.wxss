.bottom-navigation {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 500;
  display: flex;
  min-height: 104rpx;
  padding: 12rpx 28rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(23, 53, 42, 0.08);
  box-shadow: 0 -8rpx 30rpx rgba(36, 78, 56, 0.06);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  color: #98A39B;
}

.nav-icon {
  width: 42rpx;
  height: 42rpx;
}

.nav-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 560;
  line-height: 1.2;
}

.nav-item--active {
  color: #176B3A;
}
